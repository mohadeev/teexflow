# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk — https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Webhook endpoint /api/webhooks/clerk, event: user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Supabase — Project settings → API keys (server only)
NEXT_PUBLIC_SUPABASE_URL=https://amautcsfbsizgpthntab.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
# Webhook endpoint /api/webhooks/stripe, events: checkout.session.completed, customer.subscription.*
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to true once Stripe Tax is configured
STRIPE_AUTOMATIC_TAX=false

# Legal details shown on /terms, /privacy, /refunds and in the footer
NEXT_PUBLIC_LEGAL_NAME=TeexFlow
NEXT_PUBLIC_CONTACT_EMAIL=support@teexflow.com
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_GOVERNING_LAW=France
